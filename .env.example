# Crescent Construction Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Authentication & Security
# Change JWT_SECRET to a strong random key in production
JWT_SECRET= do it by yourself
ADMIN_EMAIL=
ADMIN_DEFAULT_PASSWORD=

# Email Delivery (SMTP)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=adminhashtag@gmail.com
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=adminhashtag@gmail.com

# Site URL
BASE_URL=http://localhost:5000
