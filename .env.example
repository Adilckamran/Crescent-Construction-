# Crescent Construction Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Authentication & Security
# Change JWT_SECRET to a strong random key in production
JWT_SECRET=crescent-construction-jwt-secret-change-in-production-2026!
ADMIN_EMAIL=crescentconstructionofficial@gmail.com
ADMIN_DEFAULT_PASSWORD=CrescentAdmin2026!

# Email Delivery (SMTP)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=crescentconstructionofficial@gmail.com
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=crescentconstructionofficial@gmail.com

# Site URL
BASE_URL=http://localhost:5000
